# Router-mode integration test in a disposable privileged container:
#   docker build -f deploy/Dockerfile.test -t temperance-test .
#   docker run --rm --privileged temperance-test
FROM rust:1-slim
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nftables iproute2 curl procps \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY core/ core/
COPY specs/ specs/
RUN cd core && cargo test -p temperance-gateway --test router_linux --no-run
ENV TEMPERANCE_DISPOSABLE_TEST=1
WORKDIR /workspace/core
CMD ["cargo", "test", "-p", "temperance-gateway", "--test", "router_linux", "--", "--nocapture"]
