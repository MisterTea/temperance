# Copy to .env next to compose.yml. Two different random secrets: the admin password
# (6+ characters, for the dashboard) and the gateway token (32+ characters, only used)
# by a remote temperance-gateway CLI).
TEMPERANCE_ADMIN_PASSWORD=
TEMPERANCE_GATEWAY_TOKEN=
# The HTTPS address of the dashboard; device apps only accept HTTPS.
TEMPERANCE_PUBLIC_URL=https://home.example.net
# Your (dynamic) DNS name or public IPv4, and the UDP port your router forwards.
# A free Dynu name (e.g. myhome.ddnsfree.com) works; keep it current from the dashboard's
# Settings > Remote access, which also asks the router to forward the port with UPnP.
TEMPERANCE_VPN_ENDPOINT=home.example.net:51820
TEMPERANCE_TIMEZONE=America/Chicago

# HTTPS front end to start with Temperance: caddy, cloudflared, or empty if you run your own.
COMPOSE_PROFILES=caddy
CLOUDFLARE_TUNNEL_TOKEN=

# Temperance uses this machine's network (network_mode: host). The dashboard is plain
# HTTP on this address and port; the gateway listens on the WireGuard port.
TEMPERANCE_DASHBOARD_ADDRESS=127.0.0.1
TEMPERANCE_DASHBOARD_PORT=8788
TEMPERANCE_WIREGUARD_PORT=51820
# Loopback port of the updater container's API.
TEMPERANCE_UPDATER_PORT=8790

# Leave empty for SQLite in the temperance-data volume, or use postgres://user:pass@host:5432/temperance
TEMPERANCE_DATABASE_URL=

# Beta operations (Docker/SQLite reference setup).
# Required for daily encrypted recovery and dashboard updates. Keep separately
# from copied archives; generated automatically on a fresh Docker install.
TEMPERANCE_BACKUP_PASSPHRASE=
# The default :latest image follows every release, stable or beta. For only one
# kind, set the image to :stable or :beta and the channel to match. An explicit
# image version disables dashboard auto-update; take a recovery backup before
# replacing it manually.
TEMPERANCE_UPDATE_CHANNEL=stable
# TEMPERANCE_IMAGE=mistertea/temperance:stable

# For a separate persistent Node policy server without an embedded gateway:
# TEMPERANCE_MAINTENANCE=on
# Background jobs do not run in request-scoped serverless/Worker deployments.

# Optional SMTP notifications. TLS is mandatory (465 TLS, other ports STARTTLS).
# One recipient; generic event notices only. Restart after changing these.
TEMPERANCE_SMTP_HOST=
TEMPERANCE_SMTP_PORT=587
TEMPERANCE_SMTP_FROM=
TEMPERANCE_SMTP_TO=
TEMPERANCE_SMTP_USER=
TEMPERANCE_SMTP_PASSWORD=
# Optional private CA bundle, mounted read-only; certificate verification stays enabled.
# TEMPERANCE_SMTP_CA_FILE=/run/temperance/smtp-ca.pem

# Optional reviewed feeds: HTTPS on public IPv4, no redirects; hosts or domain
# list, at most 2 MiB / 20,000 domains per category. Include source license and
# attribution. Automatic refresh replaces manual imports for that category.
# TEMPERANCE_FEEDS='[{"category":"ads","url":"https://your-reviewed-source.example/ads.txt","attribution":"Source maintainer","license":"Source license"}]'
