# The published multi-arch image, assembled from the release tarballs (see
# .github/workflows/release.yml), which are unpacked to dist/image/<amd64|arm64>/.
FROM debian:12-slim
ARG TARGETARCH
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates nftables \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --uid 10001 --create-home temperance \
  && install -d -o temperance -g temperance -m 700 /data
COPY dist/image/${TARGETARCH}/node /opt/temperance/node
COPY dist/image/${TARGETARCH}/app /opt/temperance/app
WORKDIR /opt/temperance/app
ENV PATH=/opt/temperance/node/bin:$PATH NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 \
  TEMPERANCE_DATA_DIR=/data TEMPERANCE_GATEWAY_LISTEN=0.0.0.0:51820
USER temperance
VOLUME /data
EXPOSE 3000 51820/udp
CMD ["node", "server.js"]
