[Unit]
Description=Temperance VPN policy enforcement
After=network-online.target wg-quick@temperance.service
Requires=wg-quick@temperance.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/temperance/gateway.env
WorkingDirectory=/opt/temperance
ExecStart=/opt/temperance/.venv/bin/python -m temperance.gateway --service ${TEMPERANCE_PUBLIC_URL} --uplink ${TEMPERANCE_UPLINK}
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
StateDirectory=temperance-gateway
ReadWritePaths=/var/lib/temperance-gateway
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
