# Two different random secrets: the admin password (10+ characters, for the dashboard)
# and the gateway token (32+ characters, only used by a remote temperance-gateway CLI).
TEMPERANCE_ADMIN_PASSWORD=
TEMPERANCE_GATEWAY_TOKEN=
TEMPERANCE_PUBLIC_URL=https://home.example.net
# The forwarded UDP port on your router, under a (dynamic) DNS name or public IPv4.
# A free Dynu name (e.g. myhome.ddnsfree.com) works; the dashboard's Settings > Remote
# access keeps it current and asks the router to forward this port with UPnP.
TEMPERANCE_VPN_ENDPOINT=home.example.net:51820
TEMPERANCE_TIMEZONE=America/Chicago
TEMPERANCE_GATEWAY_LISTEN=0.0.0.0:51820
TEMPERANCE_DATA_DIR=/var/lib/temperance
# Leave empty for SQLite in TEMPERANCE_DATA_DIR, or use postgres://user:pass@host:5432/temperance
TEMPERANCE_DATABASE_URL=
