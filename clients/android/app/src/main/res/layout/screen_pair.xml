<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_pair"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/Screen" android:id="@+id/column">

        <TextView style="@style/Title" android:text="@string/pair_title" android:accessibilityHeading="true" />
        <TextView style="@style/Body" android:text="@string/pair_intro" />

        <Button android:id="@+id/scan" style="@style/Primary" android:text="@string/scan" />

        <TextView android:id="@+id/link_label" style="@style/Label" android:text="@string/link_label" android:labelFor="@+id/link" />
        <EditText
            android:id="@+id/link"
            style="@style/Field"
            android:hint="@string/link_hint"
            android:importantForAutofill="no"
            android:inputType="textUri|textNoSuggestions"
            android:imeOptions="actionNext|flagNoExtractUi" />

        <TextView style="@style/Label" android:text="@string/phone_name_label" android:labelFor="@+id/phone_name" />
        <EditText
            android:id="@+id/phone_name"
            style="@style/Field"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:imeOptions="actionGo|flagNoExtractUi" />

        <TextView android:id="@+id/error" style="@style/Error" />

        <Button android:id="@+id/pair" style="@style/Primary" android:text="@string/pair" />
        <Button android:id="@+id/child_instead" style="@style/Secondary" android:text="@string/child_instead" />
    </LinearLayout>
</ScrollView>
