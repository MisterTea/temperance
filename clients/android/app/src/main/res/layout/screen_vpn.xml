<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_vpn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/Screen" android:id="@+id/column">

        <TextView style="@style/Title" android:text="@string/vpn_title" android:accessibilityHeading="true" />
        <TextView style="@style/Body" android:text="@string/vpn_intro" />

        <TextView android:id="@+id/error" style="@style/Error" />

        <Button android:id="@+id/allow_vpn" style="@style/Primary" android:text="@string/allow_vpn" />
    </LinearLayout>
</ScrollView>
