<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_setup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/Screen" android:id="@+id/column">

        <TextView style="@style/Title" android:text="@string/setup_title" android:accessibilityHeading="true" />
        <TextView style="@style/Body" android:text="@string/setup_intro" />

        <TextView style="@style/Label" android:text="@string/server_label" android:labelFor="@+id/server" />
        <EditText
            android:id="@+id/server"
            style="@style/Field"
            android:hint="@string/server_hint"
            android:autofillHints="url"
            android:inputType="textUri"
            android:imeOptions="actionNext|flagNoExtractUi" />

        <TextView style="@style/Label" android:text="@string/username_label" android:labelFor="@+id/username" />
        <EditText
            android:id="@+id/username"
            style="@style/Field"
            android:autofillHints="username"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionNext|flagNoExtractUi" />

        <TextView style="@style/Label" android:text="@string/password_label" android:labelFor="@+id/password" />
        <EditText
            android:id="@+id/password"
            android:saveEnabled="false"
            style="@style/Field"
            android:autofillHints="password"
            android:inputType="textPassword"
            android:imeOptions="actionGo|flagNoExtractUi" />

        <TextView android:id="@+id/error" style="@style/Error" />

        <Button android:id="@+id/sign_in" style="@style/Primary" android:text="@string/sign_in" />
    </LinearLayout>
</ScrollView>
