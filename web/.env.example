# Distinct random secrets, >=32 characters. Never NEXT_PUBLIC_ variables.
# TEMPERANCE_ADMIN_TOKEN is also the one-time setup token that creates the
# first owner account (username/password) on the sign-in page.
TEMPERANCE_ADMIN_TOKEN=
TEMPERANCE_GATEWAY_TOKEN=
TEMPERANCE_PUBLIC_URL=http://127.0.0.1:3000
TEMPERANCE_VPN_ENDPOINT=203.0.113.10:51820
TEMPERANCE_VPN_PUBLIC_KEY=
TEMPERANCE_TIMEZONE=UTC

# Storage backend, chosen by the URL scheme:
#   SQLite (single server, Node 24+):  sqlite:/data/temperance.sqlite3
#   PostgreSQL (any host, Vercel OK):  postgres://user:pass@host:5432/temperance
#   libSQL / Turso over HTTP:          https://<db>.turso.io  (set the token too)
TEMPERANCE_DATABASE_URL=sqlite:./data/temperance.sqlite3
TEMPERANCE_DATABASE_TOKEN=
