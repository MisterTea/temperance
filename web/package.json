{
  "name": "temperance-web",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "build:gateway": "npm --prefix gateway-addon run build",
    "start": "node scripts/start.cjs",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "cloudflare:build": "opennextjs-cloudflare build",
    "cloudflare:preview": "opennextjs-cloudflare preview",
    "cloudflare:deploy": "opennextjs-cloudflare deploy",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "storyboards": "node scripts/storyboards.mjs"
  },
  "dependencies": {
    "@temperance/gateway-addon": "file:./gateway-addon",
    "kysely": "^0.29.6",
    "next": "16.3.8",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pg-cloudflare": "^1.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "5.0.3",
    "wrangler": "^4.80.0"
  },
  "overrides": {
    "glob": "10.5.0"
  },
  "engines": {
    "node": ">=24"
  }
}
