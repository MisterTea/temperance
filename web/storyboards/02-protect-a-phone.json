{
  "title": "Protecting a phone",
  "subtitle": "Give Jordan a sign-in, then connect the Temperance app",
  "steps": [
    {
      "say": "Each client lives on the overview, with the rules and the time budget. Add a sign-in so their phone can use the app."
    },
    {
      "click": {
        "role": "button",
        "name": "Add sign-in"
      }
    },
    {
      "fill": {
        "label": "Username",
        "within": {
          "role": "form",
          "name": "/Sign-in for/"
        }
      },
      "value": "jordan"
    },
    {
      "fill": {
        "label": "Password",
        "within": {
          "role": "form",
          "name": "/Sign-in for/"
        }
      },
      "value": "purple-otter-42"
    },
    {
      "click": {
        "role": "button",
        "name": "Add sign-in"
      }
    },
    {
      "show": {
        "css": "article.profile",
        "hasText": "jordan"
      }
    },
    {
      "say": "On Jordan's phone, install the Temperance app, enter this server's address and sign in as jordan.",
      "hold": 4000
    },
    {
      "deviceSignIn": {
        "as": "phone",
        "username": "jordan",
        "password": "purple-otter-42",
        "name": "Jordan's iPhone"
      }
    },
    {
      "say": "The app makes its own VPN keys and turns on the family VPN. The phone appears right away."
    },
    {
      "click": {
        "role": "button",
        "name": "Devices",
        "exact": true
      }
    },
    {
      "show": {
        "css": "tr",
        "has": {
          "label": "Jordan's iPhone name"
        }
      },
      "hold": 2000
    },
    {
      "say": "From here you can rename it, move it to another profile, pause it, ask it where it is, or revoke it."
    },
    {
      "show": {
        "role": "button",
        "name": "Locate"
      }
    },
    {
      "say": "Prefer not to make a sign-in? A one-time enrollment code works too."
    },
    {
      "click": {
        "role": "button",
        "name": "Create enrollment code"
      }
    },
    {
      "show": {
        "label": "Enter this code in the Temperance app"
      },
      "hold": 2500
    }
  ]
}
