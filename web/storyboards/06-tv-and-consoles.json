{
  "title": "TVs and game consoles",
  "subtitle": "Protect devices that can't run the app",
  "steps": [
    {
      "click": {
        "role": "button",
        "name": "Devices",
        "exact": true
      }
    },
    {
      "say": "TVs, consoles and speakers are protected through the home network instead of the app."
    },
    {
      "show": {
        "section": "Add a home-network device"
      },
      "hold": 2500
    },
    {
      "fill": {
        "label": "Device name"
      },
      "value": "Living room Xbox"
    },
    {
      "select": {
        "label": "Client",
        "within": { "section": "Add a home-network device" }
      },
      "option": "Jordan"
    },
    {
      "click": {
        "role": "button",
        "name": "Add home device"
      }
    },
    {
      "show": {
        "role": "dialog",
        "name": "Set up Living room Xbox"
      },
      "hold": 2500
    },
    {
      "say": "Temperance assigned an address. Type that address, the subnet mask, the router and the DNS server into the Xbox.",
      "hold": 4500
    }
  ]
}
