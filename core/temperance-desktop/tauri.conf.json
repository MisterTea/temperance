{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Temperance",
  "identifier": "org.temperance.desktop",
  "build": {
    "frontendDist": "../../clients/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../clients/desktop" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../clients/desktop" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Temperance",
        "width": 560,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Temperance family controls",
    "longDescription": "Windows: protect a client's computer with your family's VPN, or open the family dashboard as an admin. Linux: open the family dashboard as an admin.",
    "category": "Utility",
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    }
  }
}
